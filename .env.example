# ===========================================================================
# Drift Detector — Root .env for Docker Compose
# Copy this file to .env and fill in your values.
# ===========================================================================

# ---------------------------------------------------------------------------
# Dashboard — Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------------------
# Dashboard — Better Auth
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="some-random-long-secret-key"
# BETTER_AUTH_URL is set automatically by docker-compose to http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard — GitHub OAuth App credentials
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ---------------------------------------------------------------------------
# Dashboard → AI Service connection
# Set automatically by docker-compose; override only for custom deployments.
# ---------------------------------------------------------------------------
# FASTAPI_BASE_URL=http://ai-service:8001

# ---------------------------------------------------------------------------
# Inter-service auth — shared secret between dashboard and ai-service.
# Both services must use the same value.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
INTERNAL_API_KEY="change-me-to-a-long-random-secret"

# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis (REST API)
# Create a free database at https://console.upstash.com
# Copy the REST URL and token from the "REST API" tab of your database.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ---------------------------------------------------------------------------
# LLM Explanation Layer & Fallback Inspector (Approach 2)
# Set EXPLAIN_LLM="1" to enable AI auditing for unflagged changes.
# Supports OpenAI, Google Gemini, Groq, OpenRouter, and Ollama.
# ---------------------------------------------------------------------------
EXPLAIN_LLM="1"
LLM_API_KEY="your-llm-api-key-here"
# LLM_BASE_URL="https://api.openai.com/v1" # Or https://api.groq.com/openai/v1 or https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL="gpt-4o-mini"
# LLM_TIMEOUT="5.0"

